// Whisper C Transpiler — Opcode → C code
// Input: classified tokens (same format as compile-full output)
// Output: C source code as string
//
// This transpiler reads classified tokens and emits C code that uses
// the runtime functions defined in runtime.c.
//
// Token types: 0=i64, 1=f64, 2=str, 3=op, 4=wordref, 5=quote,
//              6=list, 7=cond, 8=loop, 9=def, 13=bool, 14=listcount
//
// Operator bytecodes (from classify.ws):
//   0x00=dup, 0x01=swap, 0x02=drop, 0x03=rot
//   0x10=add, 0x11=sub, 0x12=mul, 0x13=div, 0x14=mod
//   0x18=eq, 0x19=lt, 0x1a=gt, 0x1b=neq, 0x1c=le, 0x1d=ge
//   0x20=and, 0x21=or, 0x22=not
//   0x40=nth, 0x41=append, 0x42=len, 0x43=map, 0x44=each, 0x45=fold
//   0x46=strlen, 0x47=strcat, 0x48=strslice, 0x49=streq, 0x4a=strlt
//   0x4b=strfind, 0x4c=strreplace, 0x4d=strtoi64, 0x4e=i64tostr
//   0x4f=strnth
//   0x50=cond, 0x51=jump, 0x52=loop, 0x53=times
//   0x60=call, 0x61=return
//   0x90=output_top, 0x91=output_all, 0x92=read_input
//   0xb0=i64tof64, 0xb1=f64toi64, 0xb2=fsqrt, 0xb3=fsin, 0xb4=fcos, 0xb5=ftan
//   0xb8=strchars, 0xb9=charsstr, 0xba=striter, 0xbb=listfind, 0xbc=strjoin

// ── C header ──────────────────────────────────────────────────────

: c-header {
    "// Auto-generated by Whisper C transpiler\n"
    "#include \"runtime.c\"\n\n"
    strcat strcat
} ;

// ── Safe C identifier from word name ──────────────────────────────
// Replace non-alphanumeric chars with _

: safe-c-name-impl {
    // input idx acc → result
    over over _ len >= ?? drop drop ]
    over over @nth          // input idx acc char
    _ 48 >= $1 57 <= & ??   // digit
        drop drop
        over over @nth ctos
        swap ` swap append
        swap 1 + swap
        safe-c-name-impl
    | _ 65 >= $1 90 <= & ?? // uppercase
        drop drop
        over over @nth ctos
        swap ` swap append
        swap 1 + swap
        safe-c-name-impl
    | _ 97 >= $1 122 <= & ?? // lowercase
        drop drop
        over over @nth ctos
        swap ` swap append
        swap 1 + swap
        safe-c-name-impl
    | _ 95 = ??              // underscore
        drop drop
        over over @nth ctos
        swap ` swap append
        swap 1 + swap
        safe-c-name-impl
    |
        // Other char → replace with _
        drop drop
        "_" swap ` swap append
        swap 1 + swap
        safe-c-name-impl
    ]]]
}
} ;

: safe-c-name {
    dup 0 "" safe-c-name-impl
} ;

// ── Emit a single token as C code ─────────────────────────────────
// Input: classified token [type, value]
// Output: C code string

: emit-token {
    dup 0 @nth              // token type
    _ 0 = ??                // I64 literal
        drop
        1 @nth              // value
        i64tostr
        "w_push((wval)(int64_t)" swap "L);\n" strcat strcat
    | _ 1 = ??              // F64 literal
        drop drop
        "// f64 literal\n"
    | _ 2 = ??              // String literal
        drop
        1 @nth              // string value
        // Emit: w_push((wval)w_str_N); — need string index
        // For now, emit inline string creation
        "w_push((wval)w_str_new(\"" swap "\")));\n"
        // Hmm, this doesn't work well. Need string pool.
        // Simplified: just emit a placeholder
        drop drop
        "// string literal\n"
    | _ 3 = ??              // Operator
        drop
        1 @nth              // opcode byte
        emit-op
    | _ 4 = ??              // WordRef
        drop
        1 @nth              // word name
        safe-c-name
        "w_" swap "();\n" strcat strcat
    | _ 5 = ??              // Quote block
        drop
        1 @nth              // inner tokens
        // Compile inner tokens inline
        { emit-token } @map
        "" { strcat } @fold
    | _ 7 = ??              // Conditional
        drop
        // [7, then_tokens, else_tokens]
        emit-cond
    | _ 8 = ??              // Loop
        drop
        // [8, body_tokens, cond_tokens]
        emit-loop
    | _ 13 = ??             // Bool
        drop
        1 @nth              // 0 or 1
        i64tostr
        "w_push((wval)" swap "L);\n" strcat strcat
    | _ 9 = ??              // Definition — skip (handled separately)
        drop drop
        ""
    |
        // Unknown — skip
        drop drop
        ""
    ]]]]]]]]
} ;

// ── Emit operator as C code ───────────────────────────────────────

: emit-op {
    dup _ 16 = ?? drop drop "{wval _b=w_pop(),_a=w_pop();w_push((wval)((int64_t)_a+(int64_t)_b));}\n"
    | dup _ 17 = ?? drop drop "{wval _b=w_pop(),_a=w_pop();w_push((wval)((int64_t)_a-(int64_t)_b));}\n"
    | dup _ 18 = ?? drop drop "{wval _b=w_pop(),_a=w_pop();w_push((wval)((int64_t)_a*(int64_t)_b));}\n"
    | dup _ 19 = ?? drop drop "{wval _b=w_pop(),_a=w_pop();if((int64_t)_b==0){fprintf(stderr,\"div0\");exit(1);}w_push((wval)((int64_t)_a/(int64_t)_b));}\n"
    | dup _ 20 = ?? drop drop "{wval _b=w_pop(),_a=w_pop();if((int64_t)_b==0){fprintf(stderr,\"div0\");exit(1);}w_push((wval)((int64_t)_a%(int64_t)_b));}\n"
    | dup _ 24 = ?? drop drop "{wval _b=w_pop(),_a=w_pop();w_push((wval)((int64_t)_a==(int64_t)_b?1L:0L));}\n"
    | dup _ 25 = ?? drop drop "{wval _b=w_pop(),_a=w_pop();w_push((wval)((int64_t)_a<(int64_t)_b?1L:0L));}\n"
    | dup _ 26 = ?? drop drop "{wval _b=w_pop(),_a=w_pop();w_push((wval)((int64_t)_a>(int64_t)_b?1L:0L));}\n"
    | dup _ 27 = ?? drop drop "{wval _b=w_pop(),_a=w_pop();w_push((wval)((int64_t)_a!=(int64_t)_b?1L:0L));}\n"
    | dup _ 28 = ?? drop drop "{wval _b=w_pop(),_a=w_pop();w_push((wval)((int64_t)_a<=(int64_t)_b?1L:0L));}\n"
    | dup _ 29 = ?? drop drop "{wval _b=w_pop(),_a=w_pop();w_push((wval)((int64_t)_a>=(int64_t)_b?1L:0L));}\n"
    | dup _ 32 = ?? drop drop "{wval _b=w_pop(),_a=w_pop();w_push((wval)((int64_t)_a&&(int64_t)_b?1L:0L));}\n"
    | dup _ 33 = ?? drop drop "{wval _b=w_pop(),_a=w_pop();w_push((wval)((int64_t)_a||(int64_t)_b?1L:0L));}\n"
    | dup _ 34 = ?? drop drop "{wval _a=w_pop();w_push((wval)((int64_t)_a==0?1L:0L));}\n"
    | dup _ 0  = ?? drop drop "w_dup();\n"
    | dup _ 1  = ?? drop drop "w_swap();\n"
    | dup _ 2  = ?? drop drop "w_drop();\n"
    | dup _ 3  = ?? drop drop "w_rot();\n"
    | dup _ 64 = ?? drop drop "{int64_t _i=(int64_t)w_pop();wval *_l=(wval*)w_pop();w_push(w_list_nth(_l,_i));}\n"
    | dup _ 65 = ?? drop drop "{wval _e=w_pop();wval *_l=(wval*)w_pop();w_push((wval)w_list_append(_l,_e));}\n"
    | dup _ 66 = ?? drop drop "{wval *_l=(wval*)w_pop();w_push((wval)w_list_len(_l));}\n"
    | dup _ 70 = ?? drop drop "{const char*_s=(const char*)w_pop();w_push((wval)(int64_t)w_str_len(_s));}\n"
    | dup _ 71 = ?? drop drop "{const char*_b=(const char*)w_pop();const char*_a=(const char*)w_pop();w_push((wval)w_str_concat(_a,_b));}\n"
    | dup _ 73 = ?? drop drop "{const char*_b=(const char*)w_pop();const char*_a=(const char*)w_pop();w_push((wval)w_str_eq(_a,_b));}\n"
    | dup _ 75 = ?? drop drop "{const char*_n=(const char*)w_pop();const char*_h=(const char*)w_pop();w_push((wval)w_str_find(_h,_n));}\n"
    | dup _ 77 = ?? drop drop "{const char*_s=(const char*)w_pop();w_push((wval)w_str_to_i64(_s));}\n"
    | dup _ 78 = ?? drop drop "{int64_t _n=(int64_t)w_pop();w_push((wval)w_i64_to_str(_n));}\n"
    | dup _ 144 = ?? drop drop "w_print_val(w_pop());\n"
    | dup _ 146 = ?? drop drop "w_push((wval)w_read_line());\n"
    | dup _ 176 = ?? drop drop "{int64_t _n=(int64_t)w_pop();double _f=(double)_n;w_push((wval)*(uint64_t*)&_f);}\n"
    | dup _ 177 = ?? drop drop "{uint64_t _b=(uint64_t)w_pop();double _f=*(double*)&_b;w_push((wval)(int64_t)_f);}\n"
    | dup _ 178 = ?? drop drop "{uint64_t _b=(uint64_t)w_pop();double _f=*(double*)&_b;_f=w_fsqrt(_f);w_push((wval)*(uint64_t*)&_f);}\n"
    | dup _ 179 = ?? drop drop "{uint64_t _b=(uint64_t)w_pop();double _f=*(double*)&_b;_f=w_fsin(_f);w_push((wval)*(uint64_t*)&_f);}\n"
    | dup _ 180 = ?? drop drop "{uint64_t _b=(uint64_t)w_pop();double _f=*(double*)&_b;_f=w_fcos(_f);w_push((wval)*(uint64_t*)&_f);}\n"
    | dup _ 181 = ?? drop drop "{uint64_t _b=(uint64_t)w_pop();double _f=*(double*)&_b;_f=w_ftan(_f);w_push((wval)*(uint64_t*)&_f);}\n"
    | dup _ 97 = ?? drop drop "return;\n"
    // Default: unknown opcode
    | drop "// unknown op\n"
    ]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]
} ;

// ── Emit conditional (if/else) ─────────────────────────────────────
// Input: token = [7, then_tokens, else_tokens]
// Uses goto-based control flow with a label counter.

: label-counter { 0 } ;
: next-label { label-counter dup _ 1 + } ;  // Hmm, can't mutate globals easily

// Simplified: emit cond/else/end with inline labels
// For now, just emit a TODO comment
: emit-cond {
    drop
    "// conditional: TODO\n"
} ;

: emit-loop {
    drop
    "// loop: TODO\n"
} ;

// ── Emit word definition as C function ─────────────────────────────
// Input: [9, name, body_tokens]
// Output: C function string

: emit-def {
    // token = [9, name, body]
    dup 1 @nth              // name
    safe-c-name             // cname
    swap 2 @nth             // cname body_tokens

    // Build function: "static void w_NAME(void) {\n"
    "static void w_" over "();\nstatic void w_" rot strcat strcat
    swap strcat
    "_(void) {\n" strcat

    // Compile body tokens
    swap                    // body_tokens c_header
    over                    // body_tokens c_header body_tokens
    { emit-token } @map     // body_tokens c_header compiled_tokens
    "" { strcat } @fold     // body_tokens c_header body_code
    swap strcat             // body_tokens c_header+body_code
    "}\n\n" strcat          // body_tokens complete_func

    swap drop               // complete_func (drop body_tokens)
} ;

// ── Main transpiler ────────────────────────────────────────────────
// Input: classified tokens (from classify-full)
// Output: complete C program string

: transpile {
    // Split defs from main tokens
    split-defs              // [main_tokens, defs_list]

    // Start with header
    c-header                // [main, defs] header

    // Emit each def as a C function
    swap                    // header [main, defs]
    dup 1 @nth              // header [main, defs] defs
    { emit-def } @map       // header [main, defs] def_codes
    "" { strcat } @fold     // header [main, defs] all_defs

    // Emit main function
    "int main(int argc, char**argv) {\n"
    "  w_init(argc, argv);\n" strcat

    // Compile main tokens
    swap 0 @nth             // header all_defs main_func_prefix main_tokens
    { emit-token } @map     // header all_defs main_func_prefix compiled
    "" { strcat } @fold     // header all_defs main_func_prefix main_code

    // Assemble: header + defs + main_prefix + main_code + closing
    strcat strcat            // header all_defs main_func
    "  return 0;\n}\n" strcat
    strcat                   // header full_program
    swap strcat              // final_program
} ;

export transpile
export emit-token
export emit-op
export safe-c-name
